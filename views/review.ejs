<%- include('partials/head') %>
<body class="bg-gradient-to-b from-black to-gray-950 text-white">
    <%- include('partials/navbar') %>
    <div class="relative w-full py-8" style="
        background: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.9)),url('<%= movie.image_url %>');
        background-size: cover;
        background-position: start;
        background-repeat: no-repeat;
        min-height: 100vh;">
        <div class="w-full max-w-7xl mx-auto">
            <div class="flex justify-between items-center w-full pb-4 border-b border-gray-700 mb-6">
                <h1 class="text-3xl font-bold text-center text-yellow-400 mb-2"><%= movie.title %></h1>
                <div class="flex items-center gap-4">
                    <p class="text-lg"><%= movie.release_year %></p>/
                    <p class="text-lg"><% let hours=Math.floor(movie.duration / 60); let
                        minutes=movie.duration % 60; %> <%= hours + "h " + minutes + "m"
                        %></p>
                </div>
            </div>
            
            <div class="flex gap-8 justify-between mb-12">
                <div class="w-1/4 flex flex-col gap-4">
                    <img src=<%= movie.image_url %>
                        alt="Movie Poster" class="w-full rounded-lg shadow-xl transition-transform duration-300 hover:scale-105">
                    <div class="flex flex-col items-start gap-4 w-full">
                        <div class="w-full flex justify-between">
                            <div class="flex items-center gap-2 text-yellow-400">
                                <i class="fa-solid fa-star text-3xl"></i>
                                <p id="avgRating" class="text-xl font-semibold font-serif"><%= movie.average_rating %></p>
                            </div>
                            <div class="flex items-center gap-2 text-yellow-400">
                                <i class="fa-solid fa-users text-lg"></i>
                                <p id="ratersNum" class="text-xl font-semibold font-serif"><%= movie.number_of_raters %></p>
                            </div>
                        </div>
                        <div class="flex w-full justify-between items-center">
                            <div id="ratingStar" class="flex space-x-1">
                                <i class="fa-solid fa-star text-2xl cursor-pointer" data-rating="1"></i>
                                <i class="fa-solid fa-star text-2xl cursor-pointer" data-rating="2"></i>
                                <i class="fa-solid fa-star text-2xl cursor-pointer" data-rating="3"></i>
                                <i class="fa-solid fa-star text-2xl cursor-pointer" data-rating="4"></i>
                                <i class="fa-solid fa-star text-2xl cursor-pointer" data-rating="5"></i>
                                
                            </div>
                            <i id="favoriteIcon" class="fa-solid fa-heart cursor-pointer text-3xl"></i>
                        </div>
                        <% if (!userIsLoggedIn) { %>
                            <p>Please log in to add rating. </p>
                      <%  } %>
                    </div>
                </div>
                <div class="w-full max-w-7xl mx-auto">
                    <div class="flex flex-col mb-6">
                        <h2 class="text-2xl font-semibold text-yellow-300 pb-4">Description</h2>
                        <p class="p-4 shadow border border-gray-700 border-l-yellow-500 border-l-2">
                            <%= movie.description %>
                        </p>
                    </div>
                    <h2 class="text-2xl font-semibold text-yellow-300 mb-4"><%= movie.title %>
                        Reviews</h2>
                    <div class="flex flex-col gap-2">
                        <div id="commentsContainer" class="grid grid-cols-1 gap-6 w-full h-full max-h-96 overflow-y-auto">
                        
                            <% if (comments.length === 0) { %>
                                <p id="noCommentsMessage" class="text-gray-300 break-words">No Comments Yet</p>
                            <% } else { %>
                                <% comments.forEach((comment, i) => { %>
                                    <div class="relative p-4 shadow border border-gray-700 border-l-yellow-500 border-l-2 max-w-full break-words">
                                        <div class="flex justify-between w-full items-center">
                                            <p class="text-yellow-300 font-bold hover:underline">
                                                <%= commenters[i] %>
                                            </p>
                                            <div>
                                                <% if (commentTimes.length === 0) { %>
                                                    <%= commentTimes[i] %>
                                                <% } else { %>
                                                    <p class="text-gray-200 mt-2">
                                                        <%= new Date(commentTimes[i]).toLocaleDateString() %>
                                                    </p>
                                                <% } %>
                                            </div>
                                        </div>
                                        <p class="text-gray-300 break-words">
                                            <%= comment %>
                                        </p>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                        <div class="flex flex-col gap-4 my-4">
                            <label for="comment" class="font-semibold text-xl">Add Comment</label>
                            <div class="flex gap-4">
                                <input type="text" name="comment" id="comment" required placeholder="Add Comment....."
                                    class="border p-2 w-1/2 rounded bg-gray-300 placeholder-gray-700 text-gray-800 focus:outline-none focus:ring-2 focus:ring-yellow-500">
                                <button
                                    id="commentSubmit" class="bg-gradient-to-t from-yellow-600 to-yellow-300 hover:from-yellow-500 hover:to-yellow-200 min-w-40 text-gray-800 font-bold rounded h-10 flex items-center justify-center">
                                    Submit
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <%- include('partials/categories.ejs')%>
    </div>
 
</body>
<script>
    const movieId = "<%= movie.id %>";
    const userRating = "<%= userRating %>";
    const userHasFavorited = "<%= userHasFavorited %>";
    const userIsLoggedIn = "<%= userIsLoggedIn %>";
  </script>
  <%- include('partials/footer.ejs')  %>
  <script src="/js/review.js"></script>
  
</html>
