<%- include('partials/head') %>
<body class="bg-gray-100">
    <%- include('partials/navbar') %>
    <div class="relative">
        <div id="custom-alert" class="fixed top-5" role="alert"></div>
        <div id="custom-confirmation" class="fixed inset-0 flex justify-center items-center bg-black bg-opacity-50 z-50 hidden">
            <div class="bg-white p-8 rounded-xl shadow-lg max-w-sm w-full sm:max-w-md">
                <p id="confirmation-message" class="text-xl font-semibold text-gray-800 text-gray-800 mb-6 text-center"></p>
                <div class="flex justify-center gap-4">
                <button id="cancel-btn" class="px-6 py-3 bg-gray-300 hover:bg-gray-400 text-gray-700 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-500">
                    Cancel
                </button>
                <button id="confirm-btn" class="px-6 py-3 bg-green-500 hover:bg-green-600 text-white rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-green-400">
                    Confirm
                </button>
                </div>
            </div>
        </div>

        <%- include('partials/categories.ejs')%>
    <div class="relative p-10">
        <h1 class="text-3xl font-bold text-gray-800 mb-6">Admin Dashboard</h1>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

            <div class="bg-white p-4 px-6 flex ietms-center justify-between rounded-lg shadow-lg">
                <div class="flex gap-4 items-center ">
                    <i class="fas fa-users text-4xl text-blue-500"></i>
                    <p class="text-xl font-semibold text-gray-800 text-gray-800">Users</p>
                </div>
                <p class="text-2xl text-blue-500"><%= dashboardDetails.userCount %></p>
            </div>

            <div class="bg-white p-4 px-6 flex ietms-center justify-between rounded-lg shadow-lg">
                <div class="flex gap-4 items-center ">
                    <i class="fas fa-film text-4xl text-red-400"></i>
                    <p class="text-xl font-semibold text-gray-800 text-gray-800">Movies</p>
                </div>
                <p class="text-2xl text-red-500"><%= dashboardDetails.movieCount %></p>
            </div>

            <div class="bg-white p-4 px-6 flex ietms-center justify-between rounded-lg shadow-lg">
                <div class="flex gap-4 items-center ">
                    <i class="fas fa-comments text-4xl text-green-500"></i>
                    <p class="text-xl font-semibold text-gray-800">Comments</p>
                </div>
                <p class="text-2xl text-green-500"><%= dashboardDetails.commentCount %></p>
            </div>

            <div class="bg-white p-4 px-6 flex ietms-center justify-between rounded-lg shadow-lg">
                <div class="flex gap-4 items-center ">
                    <i class="fas fa-star text-4xl text-yellow-400"></i>
                    <p class="text-xl font-semibold text-gray-800">Ratings</p>
                </div>
                <p class="text-2xl text-yellow-500"><%= dashboardDetails.ratingCount %></p>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-lg mt-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold text-gray-800 text-gray-800">Users</h2>
                <div class="flex gap-4 items-center">
                    <label for="emailFilter" class="block text-sm font-medium text-gray-600">Filter By Email :</label>
                    <input type="email" id="emailUserFilter" class="mt-1 block w-80 px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="Enter email">
                </div>
            </div>
            <div class="overflow-y-auto h-full max-h-72">
                <table class="w-full table-auto border-collapse border border-gray-300">
                    <thead class="bg-gray-200 sticky -top-1 z-10">
                        <tr class="text-sm text-gray-600">
                            <th class="border p-3 text-left">ID</th>
                            <th class="border p-3 text-left">Name</th>
                            <th class="border p-3 text-left">Email</th>
                            <th class="border p-3 text-left">Role</th>
                            <th class="border p-3 text-left">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody" class="text-sm text-gray-700 ">
                        <% dashboardDetails.users.forEach(user => { %>
                            <tr class="hover:bg-gray-100 transition duration-200">
                                <td class="border p-3"><%= user.id %></td>
                                <td class="border p-3"><%= user.name %></td>
                                <td class="border p-3"><%= user.email %></td>
                                <td class="border p-3"><%= user.role %></td>
                                <td class="border p-3 text-center space-x-2">
                                    <% if (user.role !== 'admin') { %>
                                        <button id="make-admin-<%= user.id %>" class="make-admin text-green-500 hover:text-green-700 transition duration-150 mr-2">
                                            <i class="fas fa-user-shield text-lg"></i> Make Admin
                                        </button>
                                    <% } else { %>
                                        <button class="make-admin text-gray-500 cursor-not-allowed">
                                            <i class="fas fa-user-shield text-lg"></i> Already Admin
                                        </button>
                                    <% } %>
                                    <button class="delete-user text-red-500 hover:text-red-700 transition duration-150">
                                        <i class="fas fa-trash text-lg"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-lg mt-6 ">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold text-gray-800">Movies</h2>
                <div class="flex gap-6 items-center">
                    <div class="flex gap-4 items-center">
                        <label for="titleFilter" class="block text-sm font-medium text-gray-600">Filter By Title :</label>
                        <input type="text" id="moviesTitleFilter" class="mt-1 block w-80 px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" placeholder="Enter title">
                    </div>
                    <button id="openMovieModal" class="p-2 px-6 bg-gradient-to-t from-yellow-500 to-yellow-300 rounded text-gray-700 font-bold hover:bg-yellow-400 transition duration-150">
                        Add New Movie
                    </button>
                </div>
            </div>
            <div class="overflow-y-auto h-full max-h-72">
                <table class="w-full table-auto border-collapse border border-gray-300">
                    <thead class="bg-gray-200 sticky -top-1 z-10">
                        <tr class="text-sm text-gray-600">
                            <th class="border p-3 text-left">ID</th>
                            <th class="border p-3 text-left">Title</th>
                            <th class="border p-3 text-left">Description</th>
                            <th class="border p-3 text-left">Release Year</th>
                            <th class="border p-3 text-left">Producer</th>
                            <th class="border p-3 text-left">Image URL</th>
                            <th class="border p-3 text-left">Category</th>
                            <th class="border p-3 text-left">Duration</th>
                            <th class="border p-3 text-left">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="movieTableBody" class="text-sm text-gray-700">
                        <% dashboardDetails.movies.forEach(movie => { %>
                        <tr class="hover:bg-gray-100 transition duration-200" data-movie-id="<%= movie.id %>">
                            <td class="border p-3"><%= movie.id %></td>
                            <td class="border p-3"><input type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="<%= movie.title %>"></td>
                            <td class="border p-3"><input type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="<%= movie.description %>"></td>
                            <td class="border p-3"><input type="number" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="<%= movie.release_year %>"></td>
                            <td class="border p-3"><input type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="<%= movie.producer %>"></td>
                            <td class="border p-3"><input type="url" class="w-full px-4 py-2 border border-gray-300 rounded-lg" value="<%= movie.image_url %>"></td>
                            <td class="border p-3">
                                <select class="w-full px-4 py-2 border border-gray-300 rounded-lg">
                                    <option value="action" <%= movie.category === 'action' ? 'selected' : '' %>>Action</option>
                                    <option value="drama" <%= movie.category === 'drama' ? 'selected' : '' %>>Drama</option>
                                    <option value="comedy" <%= movie.category === 'comedy' ? 'selected' : '' %>>Comedy</option>
                                    <option value="horror" <%= movie.category === 'horror' ? 'selected' : '' %>>Horror</option>
                                    <option value="romance" <%= movie.category === 'romance' ? 'selected' : '' %>>Romance</option>
                                    <option value="scifi" <%= movie.category === 'scifi' ? 'selected' : '' %>>Sci-Fi</option>
                                </select>                                
                            </td>
                            <td class="border p-3"><input type="number" class="w-20 px-4 py-2 border border-gray-300 rounded-lg" value="<%= movie.duration %>"></td>
                            <td class="flex w-fit h-full items-center gap-4 border p-5 text-center">
                                <button class="flex gap-2 text-green-500 hover:text-green-700 transition duration-150 save-movie w-fit h-full flex items-center justify-center">
                                    <i class="fas fa-save text-lg pointer-events-none"></i> Save
                                </button>
                                <button class="delete-movie flex gap-2 text-red-500 hover:text-red-700 transition duration-150 w-fit h-full flex items-center justify-center">
                                    <i class="fas fa-trash text-lg pointer-events-none"></i> Delete
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                    
                    </tbody>
                </table>
            </div>
        </div>
        <div id="movieModal" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center hidden z-50">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 p-6 md:p-8 relative">
                <h3 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-3">🎬 Add New Movie</h3>
                <div id="custom-form-alert" class="hidden" role="alert"></div>
                <form>
                    <div class="h-full overflow-y-auto space-y-4 p-2">
                        <div>
                            <label for="movieTitle" class="block text-sm font-medium text-gray-700">Title</label>
                            <input type="text" id="movieTitle" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none" placeholder="Enter title">
                        </div>

                        <div>
                            <label for="movieDescription" class="block text-sm font-medium text-gray-700">Description</label>
                            <textarea id="movieDescription" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none" rows="3" placeholder="Enter description"></textarea>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="movieReleaseYear" class="block text-sm font-medium text-gray-700">Release Year</label>
                                <input type="number" id="movieReleaseYear" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none" placeholder="e.g. 2025">
                            </div>

                            <div>
                                <label for="movieProducer" class="block text-sm font-medium text-gray-700">Producer</label>
                                <input type="text" id="movieProducer" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none" placeholder="Producer name">
                            </div>
                        </div>

                        <div>
                            <label for="movieImageUrl" class="block text-sm font-medium text-gray-700">Image URL</label>
                            <input type="url" id="movieImageUrl" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none" placeholder="https://...">
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="movieCategory" class="block text-sm font-medium text-gray-700">Category</label>
                                <select id="movieCategory" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none">
                                    <option value="action">Action</option>
                                    <option value="drama">Drama</option>
                                    <option value="comedy">Comedy</option>
                                    <option value="horror">Horror</option>
                                    <option value="romance">Romance</option>
                                    <option value="scifi">Sci-Fi</option>
                                </select>
                            </div>

                            <div>
                                <label for="movieDuration" class="block text-sm font-medium text-gray-700">Duration (minutes)</label>
                                <input type="number" id="movieDuration" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none" placeholder="e.g. 120">
                            </div>
                        </div>
                    </div>
                    <div class="flex justify-end mt-6 gap-4">
                        <button type="button" id="closeMovieModal" class="px-6 py-2 rounded-xl bg-gray-200 text-gray-700 hover:bg-gray-300 transition">Cancel</button>
                        <button type="submit" class="px-6 py-2 rounded-xl bg-yellow-400 text-gray-600 font-semibold hover:bg-yellow-500 transition">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    </div>
    <%- include('partials/footer.ejs')  %>
    <script src="/js/dashboard.js"></script>
</body>
</html>