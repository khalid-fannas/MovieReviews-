<%- include('partials/head') %>
  <body class="bg-black flex items-center justify-center h-screen py-10">
    <div
      class="w-full max-w-4xl bg-black rounded-lg shadow-2xl overflow-hidden flex h-full"
    >
      <div
        class="relative w-full h-auto bg-cover bg-center bg-no-repeat"
        style="
          background-image: url('https://i.pinimg.com/736x/4a/1e/d2/4a1ed27a89094933840f7701a227034b.jpg');
        "
      >
        <div
          class="absolute inset-0 flex flex-col justify-center items-center bg-black bg-opacity-50"
        >
          <p class="text-white text-4xl font-bold text-center p-4">Welcome</p>
          <div class="flex items-end">
            <p class="text-red-600 text-5xl font-bold text-center">Movie</p>
            <p class="text-xl text-white font-bold">Reviews</p>
          </div>
        </div>
      </div>

      <div
        class="w-full h-full flex items-center justify-center bg-cover bg-center bg-no-repeat"
        style="
          background-image: url('https://i.pinimg.com/736x/b7/fe/31/b7fe317f14c68ea13e93e6e9cdb40db8.jpg');
        "
      >
        <div
          class="relative flex flex-col justify-center z-10 rounded-lg p-8 shadow-lg bg-gray-600 bg-opacity-60 max-w-md mx-auto w-full h-full"
        >
          <h2 class="text-3xl font-semibold text-white text-center mb-8">
            Login
          </h2>

          <form action="/login" id="login-form" method="POST" class="w-full">
            <div class="mb-6">
              <label class="block text-gray-100 text-sm mb-2">Email</label>
              <input
                type="email"
                name="email"
                id="email"
                class="w-full px-4 py-3 bg-gray-700 border border-gray-200 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-opacity-50"
                placeholder="Enter your email"
                required
              />
            </div>

            <div>
              <label class="block text-gray-300 text-sm mb-2">Password</label>
              <input
                type="password"
                name="password"
                id="password"
                class="w-full px-4 py-3 bg-gray-700 border border-gray-200 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-opacity-50"
                placeholder="Enter your password"
                required
              />
            </div>
            
            <p id="message" class="text-white py-4 h-16"></p>
            <button
              type="submit"
              class="w-full bg-gradient-to-t from-yellow-600 to-yellow-400 text-gray-900 py-3 rounded-lg font-semibold hover:from-yellow-500 hover:to-yellow-300 transition duration-300 ease-in-out transform hover:scale-105 shadow-lg"
            >
              Login
            </button>
          </form>

          <div class="flex flex-col gap-2 items-start">
            <p class="text-gray-400 text-sm mt-6 text-center">
              Don't have an account?
              <a href="/register" class="text-yellow-400 hover:underline"
                >Sign Up</a
              >
            </p>
            <a href="/" class="text-yellow-400 text-sm hover:underline"
              >Continue As A Guest</a
            >
          </div>
        </div>
      </div>
    </div>
  </body>

 <script src="/js/login.js"></script>
</html>
