<%- include('partials/head') %>
<body class="flex flex-col min-h-screen bg-gradient-to-br from-gray-900 via-black to-gray-900 text-white font-sans">
    <div class="flex flex-1 items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
        <div class="max-w-lg w-full flex flex-col items-center gap-4 p-6 rounded-xl shadow-2xl bg-gray-800/70 backdrop-blur-md animate-fadeInUp">
            <h1 class="text-4xl font-extrabold text-yellow-400 flex items-center justify-center gap-4 drop-shadow-lg">
                <i class="fa-solid fa-face-frown-open animate-pulse"></i>
                <%= status %>
            </h1>

            <p class="text-xl text-gray-300 leading-relaxed">
                <%= message %>.
            </p>

            <a href="/" class="inline-block w-fit px-8 py-3 bg-gradient-to-t from-yellow-700 to-yellow-200 text-black font-bold rounded-xl shadow-lg hover:from-yellow-400 hover:to-yellow-200 transition-transform duration-300 hover:scale-105 active:scale-95">
                <i class="fa-solid fa-house-chimney text-xl"></i> Back to Home
            </a>
        </div>
    </div>

    <%- include('partials/footer.ejs') %>
</body>